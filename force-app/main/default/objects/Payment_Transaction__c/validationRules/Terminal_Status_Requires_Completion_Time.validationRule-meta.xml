<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Terminal_Status_Requires_Completion_Time</fullName>
    <active>true</active>
    <description
  >Terminal payment outcomes must record their completion time.</description>
    <errorConditionFormula
  >AND(OR(ISPICKVAL(Status__c, "Succeeded"), ISPICKVAL(Status__c, "Failed"), ISPICKVAL(Status__c, "Cancelled")), ISBLANK(Completed_At__c))</errorConditionFormula>
    <errorDisplayField>Completed_At__c</errorDisplayField>
    <errorMessage
  >A completion time is required for a terminal payment status.</errorMessage>
</ValidationRule>
